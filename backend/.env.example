MODEL_PROVIDER=ollama
APP_ENV=development
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CORS_DEVELOPMENT_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

CLOUD_AI_ENABLED=false
CLOUD_AI_PROVIDER=gemini
CLOUD_AI_MODEL=gemini-3.8-flash
CLOUD_AI_SEARCH_GROUNDING=true
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_API_KEY=

OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=qwen3:8b
OLLAMA_GENERAL_MODEL=qwen3:8b
OLLAMA_CODING_MODEL=qwen2.5-coder:7b
OLLAMA_EMBEDDING_MODEL=qwen3-embedding:0.6b
VISION_ENABLED=true
VISION_MODEL=qwen3-vl:8b
VISION_MAX_IMAGE_MB=10
VISION_MAX_WIDTH=4096
VISION_MAX_HEIGHT=4096
VISION_TIMEOUT_SECONDS=120

COLIBRI_BASE_URL=http://127.0.0.1:8080/v1
COLIBRI_MODEL=

REQUEST_TIMEOUT=120

SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/media/spotify/callback
FRONTEND_BASE_URL=http://127.0.0.1:5174
SPOTIFY_TOKEN_PATH=data/spotify_tokens.json

VOICE_PROVIDER=piper
# Set VOICE_PROVIDER=fish_audio to use the configured Fish Audio voice, with Piper as fallback.
FISH_AUDIO_API_KEY=
FISH_AUDIO_MODEL=s2.1-pro-free
FISH_AUDIO_REFERENCE_ID=
